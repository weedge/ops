{
  "description": "社媒舆情监听与线索",
  "properties": {
    "report_markdown": {
      "type": "string"
    },
    "leads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "profile_url",
          "why"
        ],
        "properties": {
          "platform": {
            "type": "string"
          },
          "profile_url": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "lead_type": {
            "enum": [
              "creator",
              "team_lead",
              "mcn",
              "other"
            ]
          },
          "followers": {
            "type": [
              "integer",
              "null"
            ]
          },
          "score": {
            "type": "number"
          },
          "why": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "term_stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "hits"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "hits": {
            "type": "integer"
          }
        }
      }
    }
  }
}
